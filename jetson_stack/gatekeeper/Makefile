CC := gcc
CFLAGS := -std=c11 -D_DEFAULT_SOURCE -D_XOPEN_SOURCE=700 -Wall -Wextra -O2 -Iinclude
SRC := src/protocol.c src/safety_envelope.c src/gatekeeper_core.c
SIM_SRC := $(SRC) sim/main_sim.c
UDP_SRC := $(SRC) sim/main_udp.c
BUILD := build

.PHONY: sim udp clean mcu-note

sim: $(BUILD)/gatekeeper_sim
udp: $(BUILD)/gatekeeper_udp

$(BUILD)/gatekeeper_sim: $(SIM_SRC) include/*.h
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -o $@ $(SIM_SRC)
	@echo "built: $@"

$(BUILD)/gatekeeper_udp: $(UDP_SRC) include/*.h
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -o $@ $(UDP_SRC)
	@echo "built: $@"

clean:
	rm -rf $(BUILD)

# Real STM32N6570-DK build needs ST's CMSIS-Device/HAL packs and a linker
# script, normally generated by STM32CubeMX/CubeIDE (arm-none-eabi-gcc is
# already installed on this Jetson). src/protocol.c, src/safety_envelope.c
# and src/gatekeeper_core.c are hardware-agnostic (no HAL/CMSIS includes) and
# drop into that generated project unmodified -- only a thin
# stm32_uart_bridge.c (HAL_UART_Receive_IT + DWT cycle counter, wired to
# gk_core_process) needs to be written once the CubeIDE project exists.
mcu-note:
	@echo "See docs/STM32_PORT.md for the remaining steps to build for the real board."
